# ==========================================
# CinemaMind AI - Backend Environment Config
# ==========================================

# --- Database Configuration ---
# If omitted or invalid, the backend automatically defaults to local SQLite (cinemamind.db)
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=cinemamind

# Or provide a direct SQLAlchemy database connection string (e.g. for PostgreSQL, MySQL, Railway, etc.):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/cinemamind

# --- Groq LLM API Configuration ---
# Required for the RAG Movie Chatbot assistant (/chat)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
